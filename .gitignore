# Build output
bin/
obj/

# SQLite database — local dev data, never commit it.
# (-shm and -wal are SQLite's shared-memory and write-ahead-log sidecar files.)
*.db
*.db-shm
*.db-wal

# macOS
.DS_Store

# Note: appsettings.Development.json is NOT ignored, because it holds no secrets.
# Jwt:Key lives in user-secrets (~/.microsoft/usersecrets/), outside the repo entirely.

# DEPLOYMENT SECRETS. .env now lives in this repo and holds the JWT signing key and the
# OpenAI API key. .env.example is the committed template; the real file never is.
.env
.env.local

# Database backups. deploy.sh writes one here before every migration.
dotnetai-*.db
backups/
