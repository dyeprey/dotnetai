{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // Deliberately EMPTY here. Configuration arrays merge BY INDEX, not by replacement, so a
    // dev origin left in this file cannot be removed by a later provider — an environment
    // variable can only overwrite index 0, and index 1 survives into production. Dev origins
    // live in appsettings.Development.json; production supplies its own via
    // Cors__AllowedOrigins__0.
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "AppDb": "Data Source=dotnetai.db"
  },
  "Jwt": {
    "Issuer": "dotnetai.Api",
    "Audience": "dotnetai.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "OpenAI": {
    "Model": "gpt-4o-mini",
    "SystemPrompt": "You are the assistant inside dotnetai, a small ASP.NET Core + React demo app. Be concise and concrete. Use Markdown-free plain text unless the user asks for code.",
    "MaxHistoryMessages": 40,
    "MaxMessageCharacters": 8000,
    "RequestsPerMinute": 20
  }
}
