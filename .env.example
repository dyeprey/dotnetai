# =============================================================================
# Configuration for the API stack (the .NET half). Copy to `.env` and fill in —
# compose reads `.env` from this directory automatically.
#
#   cp .env.example .env
#
# NEVER COMMIT `.env`. It holds the JWT signing key and the OpenAI key; the first
# lets anyone mint tokens for any user, the second spends your money.
#
# The React SPA is configured separately, at build time, in
# my-react-app/.env.production — see deploy/README.md.
# =============================================================================

# -----------------------------------------------------------------------------
# WHERE THE API LIVES
# -----------------------------------------------------------------------------
# The API's own hostname — a subdomain, distinct from wherever Firebase serves
# the SPA. Its A record must already point at this droplet, and ports 80 and 443
# must be open, before the first `compose up`: Caddy proves ownership over both.
#
#   API_DOMAIN=api.example.com
#
# ":80" serves plain HTTP with no certificate. Useful for a local smoke test and
# USELESS in production — Firebase Hosting is HTTPS-only, and a browser blocks an
# HTTPS page from calling an HTTP API as mixed content, before the request is
# ever sent. A Firebase-hosted SPA therefore requires a real domain here.
API_DOMAIN=:80

# Where Let's Encrypt sends expiry warnings. Unused on the ":80" profile.
ACME_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# CORS — which origins may call this API
# -----------------------------------------------------------------------------
# The SPA is on Firebase and the API is here, so every call is cross-origin and
# works only because these are listed. An origin is scheme + host + port, with no
# trailing slash: "https://x.web.app" — not "https://x.web.app/".
#
# Firebase serves every project on BOTH default domains and the SPA works on
# either, so list both or the site breaks on whichever one you did not test.
WEB_ORIGIN=https://your-project.web.app
WEB_ORIGIN_ALT=https://your-project.firebaseapp.com

# A custom domain attached to Firebase Hosting, if you have one. Leave blank
# otherwise — an empty entry never matches an Origin header, so it is inert.
WEB_ORIGIN_CUSTOM=

# -----------------------------------------------------------------------------
# SECRETS
# -----------------------------------------------------------------------------
# The HMAC key every access token is signed with. Must be at least 32 characters
# (256 bits) — JwtOptions rejects anything shorter at startup, because that is the
# minimum for HMAC-SHA256.
#
#   openssl rand -base64 48
#
# Changing it invalidates every access token in circulation. Refresh tokens are
# database rows rather than signatures, so sessions survive — clients just have to
# refresh once.
JWT_KEY=

# From platform.openai.com. Rate limiting on /chat is per user and per minute, but
# the ceiling is still your bill: set a spend limit on the OpenAI side too.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# TUNING (safe defaults; override only if you need to)
# -----------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUESTS_PER_MINUTE=20

JWT_ISSUER=dotnetai.Api
JWT_AUDIENCE=dotnetai.Client

# -----------------------------------------------------------------------------
# THE IMAGE
# -----------------------------------------------------------------------------
# Built and pushed by GitHub Actions; the droplet only pulls. IMAGE_TAG is how you
# pin and roll back:
#
#   IMAGE_TAG=latest                  follow main
#   IMAGE_TAG=sha-<full commit sha>   one exact build (this is your rollback)
#
# `docker compose pull` in deploy.sh reads these, so a rollback is a tag change and a
# re-run of the script - no rebuild anywhere.
IMAGE=ghcr.io/dyeprey/dotnetai-api
IMAGE_TAG=latest
